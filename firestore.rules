rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // INVITES — added this block
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Allow users to read their own friendships
    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        (friendshipId.matches(request.auth.uid + '_.*') ||
         friendshipId.matches('.*_' + request.auth.uid));
      allow create, update: if request.auth != null;
    }

    // Allow users to read/write messages in their conversations
    match /messages/{conversationId} {
      allow read, write: if request.auth != null &&
        (conversationId.matches('conv_' + request.auth.uid + '_.*') ||
         conversationId.matches('conv_.*_' + request.auth.uid));

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          (conversationId.matches('conv_' + request.auth.uid + '_.*') ||
           conversationId.matches('conv_.*_' + request.auth.uid));
      }
    }

    // Allow users to read/write their conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null &&
        (conversationId.matches(request.auth.uid + '_.*') ||
         conversationId.matches('.*_' + request.auth.uid));
    }

    // Allow users to read/write tasks they're involved in
    match /tasks/{taskId} {
      allow read, write: if request.auth != null &&
        (resource == null ||
         resource.data.creatorId == request.auth.uid ||
         resource.data.assigneeId == request.auth.uid);
    }

    // SHARED TASKS
    match /sharedTasks/{shareCode} {
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid;
      allow read: if true;
      allow update: if request.auth != null &&
        (resource.data.creatorId == request.auth.uid ||
         (resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.acceptedBy == request.auth.uid));
    }

    // Allow users to read/write their own notes
    match /notes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read/write their settings
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Planner tasks
    match /users/{userId}/plannerTasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Planner preferences
    match /users/{userId}/plannerPreferences/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // ASTROLOGY DATA — Cloud sync for birth charts & profiles
    // ═══════════════════════════════════════════════════════════════════════════
    match /users/{userId}/astroProfiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/astroCharts/{chartId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/astroPreferences/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Energy votes - public read, authenticated write
    match /energyVotes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Achievements - read by owner, system can write
    match /achievements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Community Holidays - public read, authenticated create/update with vote validation
    match /communityHolidays/{holidayId} {
      allow read: if true;

      // Creation: must be authenticated and set yourself as suggester
      allow create: if request.auth != null &&
        request.resource.data.suggestedByUid == request.auth.uid;

      // Update: must be authenticated, voterUids must include requester,
      // and vote counts can only change by at most 1 per field per request
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.voterUids &&
        (
          // Allow status-only updates (auto-approval)
          (request.resource.data.votesUp == resource.data.votesUp &&
           request.resource.data.votesDown == resource.data.votesDown) ||
          // Allow vote changes of at most +-1 per direction
          (request.resource.data.votesUp >= resource.data.votesUp - 1 &&
           request.resource.data.votesUp <= resource.data.votesUp + 1 &&
           request.resource.data.votesDown >= resource.data.votesDown - 1 &&
           request.resource.data.votesDown <= resource.data.votesDown + 1)
        );
    }

    // Community Features - public read, authenticated create/update with vote validation
    match /communityFeatures/{featureId} {
      allow read: if true;

      // Creation: must be authenticated (seeding by app)
      allow create: if request.auth != null;

      // Update: must be authenticated, voterUids must include requester,
      // and vote count can only increase by at most 1
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.voterUids &&
        request.resource.data.votes >= resource.data.votes &&
        request.resource.data.votes <= resource.data.votes + 1;
    }
  }
}
