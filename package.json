{
  "name": "heka-calendar-pro",
  "version": "2.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "server": "node server/print-server.js",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:build": "node build-mobile.js",
    "mobile:ios": "npx cap open ios",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew assembleRelease",
    "android:open": "npx cap open android",
    "android:debug": "npm run build && npx cap copy android && cd android && .\\gradlew assembleDebug",
    "android:setup": "node setup-android-signing.js",
    "android:clean": "cd android && .\\gradlew clean",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.1",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@vitejs/plugin-react": "^5.1.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "express": "^4.18.0",
    "firebase": "^12.9.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "jspdf": "^4.1.0",
    "pdfjs-dist": "^5.4.624",
    "puppeteer": "^21.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "swisseph-wasm": "^0.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.19.32",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.6.1"
  }
}
