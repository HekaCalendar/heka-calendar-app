# HEKA Calendar Pro — Client Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# Firebase (client-safe config; rotate keys in Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Optional: route AI calls through the backend proxy instead of the client.
# When set, provider API keys are NOT required in the client.
VITE_AI_PROXY_URL=http://localhost:8787

# Monitoring (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_DEV_ENABLED=true

# Deprecated: provider API keys should be moved to the server (.env.server).
# Leave these blank when VITE_AI_PROXY_URL is configured.
# VITE_GROQ_API_KEY=
# VITE_OPENAI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
