# HEKA Calendar Pro — Server Environment Variables
# Used by server/ai-proxy.js and server/print-server.js
# Copy this file to .env.server and fill in your values.
# DO NOT commit .env.server to version control.

# Server
AI_PROXY_PORT=8787
AI_PROXY_CORS_ORIGIN=https://your-app.vercel.app
AI_PROXY_DEV_MODE=false

# Rate limiting (per user, in-memory; use Redis in production)
AI_PROXY_RATE_LIMIT_WINDOW_MINUTES=60
AI_PROXY_RATE_LIMIT_MAX=30

# AI provider API keys (server-side only)
AI_PROXY_GROQ_KEY=your_groq_key_here
AI_PROXY_OPENAI_KEY=your_openai_key_here
AI_PROXY_ANTHROPIC_KEY=your_anthropic_key_here
AI_PROXY_MOONSHOT_KEY=your_moonshot_key_here
AI_PROXY_MOONSHOT_BASE=https://api.moonshot.ai/v1

# Firebase Admin for token verification and Firestore audit logs
# Provide either the path to a service account JSON file or the JSON contents.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Enterprise billing integrations
STRIPE_SECRET_KEY=sk_live_...
REVENUECAT_SECRET_KEY=sk_...
