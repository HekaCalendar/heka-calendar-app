# HEKA AI Proxy runtime secrets
# Copy to .env.server and fill in the keys for the providers you want to support.
# Never commit .env.server.

AI_PROXY_GROQ_KEY=
AI_PROXY_OPENAI_KEY=
AI_PROXY_ANTHROPIC_KEY=
AI_PROXY_MOONSHOT_KEY=
AI_PROXY_MOONSHOT_BASE=https://api.moonshot.ai/v1

# Optional runtime tuning
AI_PROXY_PORT=8787
AI_PROXY_CORS_ORIGIN=*
AI_PROXY_RATE_LIMIT_WINDOW_MINUTES=60
AI_PROXY_RATE_LIMIT_MAX=30

# Firebase Admin initialization (production)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

FIREBASE_PROJECT_ID=heka-calendar

FIREBASE_API_KEY=your_firebase_web_api_key
